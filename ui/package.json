{
  "name": "fathom-ui",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:fake": "vite --mode fake",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "e2e:serve": "vite build --mode fake --outDir dist-e2e && vite preview --outDir dist-e2e --port 4173 --strictPort",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:live": "playwright test -c playwright.live.config.ts",
    "e2e:prod-rbac": "playwright test -c playwright.prod-rbac.config.ts",
    "e2e:hosted": "playwright test -c playwright.hosted.config.ts",
    "e2e:live:serve": "vite build --mode live --outDir dist-live && vite preview --outDir dist-live --port 4174 --strictPort",
    "promo": "playwright test -c playwright.promo.config.ts",
    "tauri": "tauri",
    "test:driver": "node --experimental-strip-types --test tests/driver/*.test.ts"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/yuji-boku": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.13",
    "@tauri-apps/api": "~2.10.1",
    "@xterm/addon-fit": "^0.10.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "cytoscape": "^3.34.3",
    "d3-force": "^3.0.0",
    "diff": "^8.0.2",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.13.1",
    "recharts": "^3.10.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "xterm": "^5.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.11.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/cytoscape": "^3.31.0",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@12.4.2"
}
