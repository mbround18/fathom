{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fathom",
  "version": "0.1.0",
  "identifier": "dev.fathom.app",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Fathom",
        "width": 1280,
        "height": 800,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "publisher": "Fathom",
    "homepage": "https://github.com/mbround18/fathom",
    "license": "Apache-2.0",
    "shortDescription": "Kubernetes dashboard for your desktop",
    "longDescription": "Fathom is a desktop Kubernetes dashboard. It reads your kubeconfig, lists and inspects workloads, streams logs, and can create a local kind cluster when you do not have one yet.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["ca-certificates"]
      },
      "rpm": {
        "depends": ["ca-certificates"]
      }
    }
  }
}
