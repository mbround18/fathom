{
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" },
    { "path": "./tsconfig.test.json" }
  ],
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    // Read by the shadcn CLI only (components.json aliases); the referenced projects resolve the
    // workspace packages through node_modules.
    "paths": {
      "@/*": ["./src/*"],
      "@companion/terminal": ["../packages/terminal/src"],
      "@companion/ui": ["../packages/ui/src"],
      "@companion/theme": ["../packages/theme/src"]
    }
  }
}
