# Keel dev stack settings for compose.yaml. Copy to .env (git-ignored) and fill in.
# Placeholders only: never commit real values.

# The https origin people and webhooks use. Its host must resolve to this machine (DNS or
# /etc/hosts), and the TLS certificate must name it. Keep the port in step with KEEL_HTTPS_PORT.
KEEL_PUBLIC_URL=https://keel-dev.lan:8443

# Names on the runner listener's SSH host certificate, comma-separated. Runners connect to one of
# them (keel_runner_server = <name>:KEEL_RUNNER_PORT).
KEEL_RUNNER_HOST_NAMES=keel-dev.lan

# Host ports: HTTPS (UI, /api, /hooks) and the runner SSH listener.
KEEL_HTTPS_PORT=8443
KEEL_RUNNER_PORT=7831

# Host directory holding tls.crt, tls.key and master.key, mounted read-only at /run/keel.
# `make keel compose-secrets` creates them (relative paths are from apps/keel). Git-ignored.
KEEL_SECRETS_DIR=./secrets
# The name and SANs on the self-signed certificate compose-secrets makes.
KEEL_TLS_NAME=keel-dev.lan

# PostgreSQL owner password. Letters and digits only: it is placed in a URL unescaped.
KEEL_DB_PASSWORD=change-me

# One sign-in provider at least. GitHub: an OAuth app whose callback is
# <KEEL_PUBLIC_URL>/auth/callback/github.
KEEL_GITHUB_CLIENT_ID=
KEEL_GITHUB_CLIENT_SECRET=
# Or OIDC (issuer URL, client id, optional secret and scopes):
KEEL_OIDC_ISSUER=
KEEL_OIDC_CLIENT_ID=
KEEL_OIDC_CLIENT_SECRET=
KEEL_OIDC_SCOPES=
# Or Discord:
KEEL_DISCORD_CLIENT_ID=
KEEL_DISCORD_CLIENT_SECRET=

# Signed mode for new bindings.
KEEL_SIGNED_MODE_DEFAULT=false

# Log filter (EnvFilter syntax) and an optional OTLP endpoint.
KEEL_LOG=info
OTEL_EXPORTER_OTLP_ENDPOINT=

# The image compose runs; `make keel image` builds mbround18/keel:latest.
KEEL_IMAGE=mbround18/keel:latest

# docker compose restart policy for both services (unless-stopped on a server).
RESTART_POLICY=no
