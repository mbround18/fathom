# Depths settings for compose.yaml. Copy to .env; full list in docs/guides/depths.

# The https URL people open. Redirect URIs are <this>/auth/callback/<provider>.
DEPTHS_PUBLIC_URL=https://depths.example.com

# Where the stacks live on the host (Dockge's stacks dir works as is).
STACKS_DIR=/opt/stacks

# One sign-in provider: discord, github, or OIDC via DEPTHS_OIDC_ISSUER.
OAUTH_PROVIDER=discord
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Who is admin from the first sign-in: your provider user id (a Discord id, a GitHub login or
# numeric id). Comma-separate several. Everyone else signs in as pending until an admin lets them in.
OWNER_USER_ID=

# Reverse proxies allowed to tell Depths the client address (CIDRs, comma-separated).
DEPTHS_TRUSTED_PROXIES=

# Network trust (docs/guides/depths/security.md). New networks get a restricted view until
# trusted: the first network, "home" after the waiting period, a whitelist, or this list.
DEPTHS_NETWORK_GATE=true
DEPTHS_NETWORK_MATURITY_DAYS=7
# Always trusted, comma-separated CIDRs (your LAN, a tailnet such as 100.64.0.0/10).
DEPTHS_TRUSTED_NETWORKS=
# Optional City .mmdb (DB-IP Lite or GeoLite2) for approximate locations; display only.
DEPTHS_GEOIP_DB=

# Container shells in the web UI. Also set DEPTHS_SOCKET_EXEC=1 to open EXEC on the proxy.
DEPTHS_FEATURE_SHELL=false
DEPTHS_SOCKET_EXEC=0

# Who may open a shell by the container's security level (docs/guides/depths/security.md):
# strict = never in a container that can reach the host, admins only in a root one; relaxed =
# admins in either, users in root ones.
DEPTHS_SHELL_POLICY=strict

# Compose findings that let a container reach the host: warn shows them; enforce refuses a
# user's deploy or save and makes an admin acknowledge them. Files are never rewritten.
DEPTHS_COMPOSE_POLICY=warn

# docker compose restart policy for both services (unless-stopped on a server).
RESTART_POLICY=no
