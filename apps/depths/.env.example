# Depths settings for compose.yaml. Copy to .env; full list in docs/guides/depths.

# The https URL people open. Redirect URIs are <this>/auth/callback/<provider>.
DEPTHS_PUBLIC_URL=https://depths.example.com

# Where the stacks live on the host (Dockge's stacks dir works as is).
STACKS_DIR=/opt/stacks

# One sign-in provider: discord, github, or OIDC via DEPTHS_OIDC_ISSUER.
OAUTH_PROVIDER=discord
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Who is admin from the first sign-in: your provider user id (a Discord id, a GitHub login or
# numeric id). Comma-separate several. Everyone else signs in as pending until an admin lets them in.
OWNER_USER_ID=

# Reverse proxies allowed to tell Depths the client address (CIDRs, comma-separated).
DEPTHS_TRUSTED_PROXIES=

# Container shells in the web UI. Also set DEPTHS_SOCKET_EXEC=1 to open EXEC on the proxy.
DEPTHS_FEATURE_SHELL=false
DEPTHS_SOCKET_EXEC=0

# docker compose restart policy for both services (unless-stopped on a server).
RESTART_POLICY=no
